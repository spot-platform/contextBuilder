{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpotPrice",
  "type": "object",
  "required": [
    "base_fee",
    "included_items",
    "optional_addons",
    "refund_policy",
    "summary_line"
  ],
  "additionalProperties": false,
  "properties": {
    "base_fee": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000
    },
    "included_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 30},
          "value": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "optional_addons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "price", "mechanism", "explanation"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 30},
          "price": {"type": "integer", "minimum": 0, "maximum": 200000},
          "mechanism": {"type": "string", "enum": ["fixed", "funding", "realcost"]},
          "explanation": {"type": ["string", "null"], "maxLength": 120}
        }
      }
    },
    "refund_policy": {
      "type": ["object", "null"],
      "required": ["cutoff_hours", "full_refund_until", "note"],
      "additionalProperties": false,
      "properties": {
        "cutoff_hours": {"type": "integer", "minimum": 0, "maximum": 168},
        "full_refund_until": {"type": ["string", "null"], "maxLength": 80},
        "note": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "summary_line": {
      "type": ["string", "null"],
      "minLength": 10,
      "maxLength": 200
    }
  }
}
